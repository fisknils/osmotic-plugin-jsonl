{
	"name": "osmotic-plugin-jsonl",
	"version": "1.0.0",
	"description": "osmotic plugin that exports scraped rows to JSON Lines files, streamed to disk one object per line",
	"keywords": [
		"osmotic-plugin",
		"osmotic",
		"jsonl",
		"json-lines",
		"ndjson",
		"export",
		"scraper"
	],
	"license": "ISC",
	"author": {
		"name": "fisknils",
		"url": "https://github.com/fisknils"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fisknils/osmotic-plugin-jsonl.git"
	},
	"homepage": "https://github.com/fisknils/osmotic-plugin-jsonl#readme",
	"bugs": {
		"url": "https://github.com/fisknils/osmotic-plugin-jsonl/issues"
	},
	"type": "commonjs",
	"main": "dist/index.cjs",
	"types": "dist/index.d.cts",
	"files": [
		"dist",
		"examples",
		"README.md"
	],
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "npm run clean && tsc -p tsconfig.dist.json",
		"prepublishOnly": "npm run build",
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
		"test": "npm run build && tsc -p tsconfig.test.json && node --import tsx --test \"test/*.ts\"",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"peerDependencies": {
		"osmotic": "^3.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"osmotic": "file:../osmotic",
		"prettier": "3.3.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
